import java.util.Arrays;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            long[] a = new long[3];

            for (int i = 0; i < 3; i++) {
                a[i] = sc.nextLong();
            }

            Arrays.sort(a);

            long answer = Math.min(a[2] - a[0], a[1]);
            System.out.println(answer);
        }

        sc.close();
    }
}
