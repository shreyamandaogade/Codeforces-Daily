import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            String s = sc.next();

            int firstSum = 0;
            int lastSum = 0;

            for (int i = 0; i < 3; i++) {
                firstSum += s.charAt(i) - '0';
            }

            for (int i = 3; i < 6; i++) {
                lastSum += s.charAt(i) - '0';
            }

            if (firstSum == lastSum) {
                System.out.println("YES");
            } else {
                System.out.println("NO");
            }
        }

        sc.close();
    }
}
