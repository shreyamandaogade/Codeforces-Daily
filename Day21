import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();

            int[] a = new int[n];
            Map<Integer, Integer> freq = new HashMap<>();

            long totalSum = 0;
            int maxFreq = 0;
            int maxValue = 0;

            for (int i = 0; i < n; i++) {
                a[i] = sc.nextInt();
                totalSum += a[i];

                int count = freq.getOrDefault(a[i], 0) + 1;
                freq.put(a[i], count);

                if (count > maxFreq) {
                    maxFreq = count;
                    maxValue = a[i];
                }
            }

            int others = n - maxFreq;

            if (maxFreq <= others + 1) {
                System.out.println(totalSum);
            } else {
                long otherDamage =
                        totalSum - (long) maxFreq * maxValue;

                long answer =
                        otherDamage + (long) (others + 2) * maxValue;

                System.out.println(answer);
            }
        }

        sc.close();
    }
}
